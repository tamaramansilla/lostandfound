* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background-color: #fff5f7;
    color: #2b1b1f;
}

header {
    background: linear-gradient(135deg, #c9184a, #ff4d6d);
    color: white;
    text-align: center;
    padding: 35px 20px;
}

.logo {
    font-size: 30px;
    font-weight: bold;
    margin-bottom: 8px;
}

header p {
    font-size: 16px;
}

main {
    width: 90%;
    max-width: 1100px;
    margin: 30px auto;
}

.area-navigation {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

.area-button {
    border: 2px solid #ff4d6d;
    padding: 12px 20px;
    border-radius: 25px;
    background-color: white;
    color: #c9184a;
    cursor: pointer;
    font-weight: bold;
    transition: 0.2s;
}

.area-button:hover,
.area-button.active {
    background-color: #ff4d6d;
    color: white;
}

.filters {
    display: flex;
    gap: 20px;
    background-color: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 30px;
    border: 1px solid #ffd1dc;
    box-shadow: 0 3px 10px rgba(201, 24, 74, 0.08);
}

.filters div {
    display: flex;
    align-items: center;
    gap: 8px;
}

select,
input,
textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #f3a6b8;
    border-radius: 7px;
    font-size: 15px;
    background-color: #fffafb;
}

select:focus,
input:focus,
textarea:focus {
    outline: 2px solid #ff8fa3;
    border-color: #ff4d6d;
}

.filters select {
    width: auto;
}

h2 {
    color: #a4133c;
    margin-bottom: 20px;
}

.pet-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.pet-card {
    background-color: white;
    border-radius: 15px;
    overflow: hidden;
    border: 1px solid #ffd1dc;
    box-shadow: 0 4px 15px rgba(201, 24, 74, 0.12);
    transition: transform 0.2s, box-shadow 0.2s;
}

.pet-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(201, 24, 74, 0.18);
}

.pet-card img {
    width: 100%;
    height: 280px;
    object-fit: cover;
}

.pet-info {
    padding: 18px;
}

.status {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 20px;
    color: white;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 10px;
}

.lost {
    background-color: #d90429;
}

.found {
    background-color: #e85d75;
}

.pet-info h3 {
    color: #a4133c;
    font-size: 22px;
    margin-bottom: 6px;
}

.pet-details {
    color: #777;
    margin-bottom: 10px;
}

.area {
    font-weight: bold;
    color: #c9184a;
    margin-bottom: 10px;
}

.description {
    line-height: 1.5;
    margin-bottom: 15px;
    color: #493136;
}

.contact {
    font-weight: bold;
    color: #c9184a;
    margin-bottom: 8px;
}

small {
    color: #888;
}

.report-section {
    background-color: white;
    margin-top: 50px;
    padding: 30px;
    border-radius: 15px;
    border: 1px solid #ffd1dc;
    box-shadow: 0 4px 15px rgba(201, 24, 74, 0.1);
}

form {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

form label {
    color: #a4133c;
    font-weight: bold;
    margin-top: 10px;
}

textarea {
    min-height: 120px;
    resize: vertical;
}

form button {
    margin-top: 15px;
    padding: 13px;
    border: none;
    border-radius: 8px;
    background: linear-gradient(135deg, #c9184a, #ff4d6d);
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s;
}

form button:hover {
    background: linear-gradient(135deg, #a4133c, #c9184a);
    transform: translateY(-1px);
}

footer {
    text-align: center;
    padding: 30px;
    margin-top: 40px;
    background-color: #a4133c;
    color: white;
}

@media (max-width: 800px) {
    .pet-feed {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 550px) {

    .logo {
        font-size: 24px;
    }

    main {
        width: 94%;
    }

    .filters {
        flex-direction: column;
    }

    .filters select {
        width: 100%;
    }

    .pet-feed {
        grid-template-columns: 1fr;
    }

    .pet-card img {
        height: 300px;
    }
}
